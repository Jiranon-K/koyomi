# Copy to .env.local and adjust. Never commit .env.local.
MONGODB_URI=mongodb://127.0.0.1:27017/nextjs-fullstack

# Better Auth. Generate a secret of at least 32 random characters, e.g. `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
# Public origin of the app (no trailing slash).
BETTER_AUTH_URL=http://localhost:3000

# Optional. Comma-separated emails that become admins when their account is created
# (case-insensitive, spaces ignored). Everyone else is a regular user.
# Roles are assigned at creation only: adding an email here later does NOT promote an existing account.
ADMIN_EMAILS=

# Optional: Google sign-in. Leave both empty to keep it off (the button is then hidden).
# Setting only one of the two also keeps it off and logs a warning naming the missing one.
# Setup steps are in README.md.
# Authorized redirect URI to register with Google: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

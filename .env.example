# Copy to .env.local and adjust. Never commit .env.local.
MONGODB_URI=mongodb://127.0.0.1:27017/koyomi

# Better Auth. Generate a secret of at least 32 random characters, e.g. `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
# Public origin of the app (no trailing slash).
BETTER_AUTH_URL=http://localhost:3000

# Optional. Comma-separated emails that become admins when their account is created
# (case-insensitive, spaces ignored). Everyone else is a regular user.
# Roles are assigned at creation only: adding an email here later does NOT promote an existing account.
ADMIN_EMAILS=

# Schedule source: an AnimeSchedule.net API v3 application token (account settings, API tab).
# Needed to sync the real schedule; not needed to browse pages or when USE_FAKES is true.
ANIMESCHEDULE_TOKEN=

# Optional, true or false. true replaces the external services with deterministic fakes (the
# end-to-end server sets it) and opens the unauthenticated /api/dev routes. Never set it in production.
USE_FAKES=

# LINE (optional: with all of these empty the app runs without LINE and shows no LINE button).
# One-time setup in the LINE Developers Console (https://developers.line.biz/console/):
#   1. Create ONE provider. Both channels below must sit under it, or the LINE user id that LINE
#      Login reports will not match the one the Messaging API sends.
#   2. Under it create a "LINE Login" channel (web app). On its LINE Login tab set the callback URL
#      to <BETTER_AUTH_URL>/api/auth/callback/line, e.g. http://localhost:3000/api/auth/callback/line
#      (one line per environment). To let people sign UP with LINE, also apply for the
#      "Email address permission" on its Basic settings tab; without it LINE shares no email and
#      LINE can only be connected from Settings by someone who already has an account.
#   3. Under the same provider create a "Messaging API" channel (this is the bot). Set its webhook
#      URL to <public origin>/api/line/webhook and switch "Use webhook" on. LINE needs a public
#      HTTPS address, so use a tunnel in development.
#   4. Back on the LINE Login channel, Basic settings, "Linked LINE Official Account": pick the bot.
#      That is what makes LINE offer "add friend" during login and lets the app ask LINE whether
#      a user is already a friend.
# Channel ID and channel secret of the LINE Login channel. Set both or neither.
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
# Channel secret of the Messaging API channel. It verifies the signature on webhook calls; while it
# is empty the webhook refuses every call.
LINE_MESSAGING_CHANNEL_SECRET=
# Optional. The bot's basic ID from the Messaging API tab, with the @ (for example @123abcde).
# Settings then shows an "Add the bot" link to users who have not added it yet.
LINE_BOT_BASIC_ID=
# Channel access token (long-lived) of the same Messaging API channel, from its Messaging API tab.
# The daily digest is pushed with it; while it is empty every push fails and is retried.
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=

# Upstash QStash (optional: without it nothing runs on a timer; pages and tests still work).
# QStash calls the job endpoints under <BETTER_AUTH_URL>/api/jobs/ on a schedule and for each
# queued job, so BETTER_AUTH_URL must be the public HTTPS origin. One-time setup:
#   1. Create an Upstash account and open QStash (https://console.upstash.com/qstash).
#   2. Copy QSTASH_TOKEN and both signing keys from the console into the deployment's environment.
#   3. Deploy, then create the three schedules (sync every six hours, sync at 08:45 and digest at
#      09:00 Bangkok time) from a shell that has QSTASH_TOKEN and the deployed BETTER_AUTH_URL:
#        bun scripts/create-qstash-schedules.ts --dry-run   (prints them, calls nothing)
#        bun scripts/create-qstash-schedules.ts
#      It is safe to run again: the schedules have fixed ids and are overwritten.
# Token the app publishes jobs with.
QSTASH_TOKEN=
# Optional. The QStash API address when the account is not in the default region
# (default https://qstash.upstash.io).
QSTASH_URL=
# The two keys QStash signs its calls with. Set both; while either is empty every job endpoint
# refuses every call.
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

#!/usr/bin/env bash
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

deleted=0000000000000000000000000000000000000000
while read -r _ local_sha remote_ref _; do
  case "$remote_ref" in refs/heads/*) ;; *) continue ;; esac
  [ "$local_sha" = "$deleted" ] && continue
  bun scripts/check-git-conventions.ts branch "${remote_ref#refs/heads/}"
done

bash ./verify.sh
E2E_SKIP_BUILD=1 bun run e2e
